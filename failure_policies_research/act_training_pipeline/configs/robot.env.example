# ──────────────────────────────────────────────────────────────
# Robot & dataset environment variables
# Copy this file to configs/robot.env and fill in your values.
#   cp configs/robot.env.example configs/robot.env
# ──────────────────────────────────────────────────────────────

# ── SO-101 serial ports ──────────────────────────────────────
# Run `lerobot-find-port` to discover these.
ROBOT_PORT_FOLLOWER="/dev/tty.usbmodem5AE60583121"
ROBOT_PORT_LEADER="/dev/tty.usbmodem5AE60798501"

# Calibration IDs (must match filenames in ~/.cache/huggingface/lerobot/calibration/)
ROBOT_ID="so101_follower_1"
TELEOP_ID="so101_leader_1"

# ── Hugging Face ─────────────────────────────────────────────
HF_USER="your_hf_username"

# ── Dataset ──────────────────────────────────────────────────
DATASET_NAME="so101_pick_cube"
DATASET_TASK="Pick up the cube and place it in the bin"
DATASET_NUM_EPISODES=50
DATASET_EPISODE_TIME_S=60
DATASET_FPS=30

# ── Training ─────────────────────────────────────────────────
# Device: "cuda", "mps", or "cpu"
DEVICE="mps"
TRAIN_STEPS=100000
BATCH_SIZE=8
EVAL_FREQ=20000
SAVE_FREQ=20000

# ── ACT policy overrides ────────────────────────────────────
# These match ACTConfig defaults; uncomment to change.
# CHUNK_SIZE=100
# DIM_MODEL=512
# N_HEADS=8
# N_ENCODER_LAYERS=4
# N_DECODER_LAYERS=1
# KL_WEIGHT=10.0
# LEARNING_RATE=1e-5

# ── Camera (optional) ───────────────────────────────────────
# Set CAMERA_INDEX to the OpenCV device index (usually 0 for built-in webcam).
# Leave empty to record without camera.
# CAMERA_INDEX=0
# CAMERA_WIDTH=640
# CAMERA_HEIGHT=480
# CAMERA_FPS=30
